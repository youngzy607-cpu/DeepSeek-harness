{
  "version": 3,
  "plugins": [
    {
      "directory": "custom-instructions",
      "packageName": "dsh-custom-instructions"
    },
    {
      "directory": "harness-sync",
      "packageName": "dsh-harness-sync"
    },
    {
      "directory": "plugin-manager",
      "packageName": "dsh-plugin-manager"
    },
    {
      "directory": "skill-manager",
      "packageName": "dsh-skill-manager"
    },
    {
      "directory": "usage-monitor",
      "packageName": "dsh-usage-monitor"
    }
  ],
  "excludes": [
    ".credentials.yaml",
    "sessions",
    "storages",
    "browser-cache",
    "node_modules"
  ]
}
